# Copy this file to ".env" (same folder) and edit the copy.
# NEVER commit the real .env file: it is listed in .gitignore.

# OPTIONAL. Get a free key at https://console.groq.com/keys
# Leave empty to use DEMO MODE (works without any key).
GROQ_API_KEY=

# OPTIONAL. Groq model name. Check https://console.groq.com/docs/models for current names.
GROQ_MODEL=llama-3.3-70b-versatile

# Browser addresses allowed to call this API (comma-separated, no trailing slash).
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# After deploying the frontend on Vercel, ADD your real Vercel URL, for example:
# CORS_ORIGINS=http://localhost:5173,https://your-app-name.vercel.app

# true  = if the AI fails (rate limit, network...), show a demo itinerary and explain why
# false = show the error instead
FALLBACK_TO_DEMO=true
