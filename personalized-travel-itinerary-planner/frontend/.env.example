# Copy this file to ".env" (same folder) and edit the copy.
# Vite only exposes variables that start with VITE_. They end up in the browser,
# so NEVER put secret keys here (no Groq key, no Supabase service_role key).

# Address of the FastAPI backend (no trailing slash).
# Local:       http://localhost:8000
# Production:  https://your-backend-name.onrender.com
VITE_API_URL=http://localhost:8000

# OPTIONAL - only needed for sign-in and cloud-saved trips.
# Supabase dashboard -> Project Settings -> API (or "API Keys").
# Use the Project URL and the public "anon" (or "publishable") key. NOT the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
